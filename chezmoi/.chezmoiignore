{{/* nvim: VM profile ships only a whitelist of plugin specs. Chezmoi has no
     "ignore this directory, then re-include selected children" other than `!`
     excludes, which take priority over all includes, so: exclude the whole
     directory, then re-include the essentials. Lazy still runs
     `{ import = "plugins" }`; it simply finds these files instead of all 61. */}}
.config/nvim/lua/plugins/*
!.config/nvim/lua/plugins/chezmoi-vim.lua
!.config/nvim/lua/plugins/cmdalias.lua
!.config/nvim/lua/plugins/comment-nvim.lua
!.config/nvim/lua/plugins/conform.lua
