{{/* nvim: non-essential plugin specs live in lua/opt-plugins, a SEPARATE target
     directory from lua/plugins. This matters: chezmoi's exact_ pruning compares
     the target dir against the directory's source children, and a source file
     that is merely IGNORED still counts as a source child — so ignoring
     lua/plugins/* does not remove already-applied specs. A different target
     directory has no stale children to begin with. init.lua imports it behind a
     cond guard, so the absent directory does not raise "No specs found". */}}
.config/nvim/lua/opt-plugins
{{ end -}}
{{/* nvim init.lua is Ubuntu/VM-only: Nix machines get init via customRC (packages/neovim) */}}
