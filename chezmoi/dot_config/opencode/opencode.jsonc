{
  "$schema": "https://opencode.ai/config.json",
  "theme": "kanagawa",
  "autoupdate": false,
  "provider": {
    "aihubmix": {
      "models": {
        "cc-minimax-m2.1": {
          "options": {
            "reasoningEffort": "high",
            "textVerbosity": "low",
            "reasoningSummary": "auto",
          },
        },
      },
    },
  },
  "default_agent": "towner",
  "model": "aihubmix/cc-minimax-m2.1",
  "small_model": "aihubmix/cc-minimax-m2.1",
  "agent": {
    "towner": {
      "description": "Gastown person",
      "model": "aihubmix/cc-minimax-m2.1",
      "prompt": "You are a member of the Gas town. You use `gt` in one of the predescribed Gas town roles",
    },
  },
}
