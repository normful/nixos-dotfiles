set -U fish_greeting ""

set -gx LANG 'en_US.UTF-8'
set -gx LC_ALL 'en_US.UTF-8'

if status is-interactive
    ##############################################################
    # SETTINGS AND ENV VARS
    ##############################################################

    # Use vi-style modal key bindings (normal/insert/visual modes)
    # rather than the default Emacs-style bindings.
    set -g fish_key_bindings fish_vi_key_bindings
    # How long (ms) fish waits after receiving an escape character to
    # decide if it's the standalone Escape key or the start of an escape
    # sequence (e.g. arrow keys, function keys). Default is 30ms.
    # Lower values feel more responsive but may break Alt+key combos
    # that send escape+char sequences.
    set -g fish_escape_delay_ms 10

    # ----- DOUBLE-ESCAPE: CLEAR COMMAND LINE ---------------------------------
    # How long (ms) fish waits for a multi-key sequence like escape,escape
    # before treating the first keypress as standalone. Higher = more
    # forgiving for double-tap, but adds slight delay to single keypresses.
    set -g fish_sequence_key_delay_ms 300

    # Double-escape clears the entire command line.
    # -M insert: works while typing (first escape exits insert→normal mode,
    #   second escape within the delay fires the bind)
    # -M default: also works if you're already in vi normal mode
    bind -M insert escape,escape 'commandline -r ""; commandline -f repaint'
    bind -M default escape,escape 'commandline -r ""; commandline -f repaint'
    # -------------------------------------------------------------------------

    # If SSH'ing in, attach to herdr
    if set -q SSH_CONNECTION
        herdr
    end

    # if command -v hh >/dev/null 2>&1
    #   set --export HISTFILE ~/.config/fish/hh.history
    #   set --export HSTR_CONFIG hicolor,prompt-bottom
    # end

    if command -v intelephense >/dev/null 2>&1
      set --export INTELEPHENSE_LICENSE_KEY {{ (keepassxc "intelephense-key").Password }}
    end

    if command -v lean-ctx >/dev/null 2>&1
      # See https://github.com/yvgude/lean-ctx/blob/6588c16a18d5637d65f1fb810e23de1f728a7a9a/rust/src/core/config/schema.rs
      set --export LEAN_CTX_BIN /run/current-system/sw/bin/lean-ctx
      set --export LEAN_CTX_NO_UPDATE_CHECK "1"
      set --export LEAN_CTX_OUTPUT_DENSITY "normal" # normal, terse, or ultra
      set --export LEAN_CTX_TERSE_AGENT "lite" # off, lite, full, ultra
      set --export LEAN_CTX_COMPRESSION "standard" # off, lite, standard, max
      set --export LEAN_CTX_MINIMAL "true"
      set --export LEAN_CTX_SAVINGS_FOOTER "never" # auto, always, never
    end

    if command -v prek >/dev/null 2>&1
      set --export PREK_QUIET "1"
    end

    set --export PI_TELEMETRY "0"
    set --export PI_OFFLINE "1"
    set --export TELEMETRY_ENABLED false
    set --export DO_NOT_TRACK "1"
    set --export OPENSPEC_TELEMETRY "0"

    set --export PUPPETEER_EXECUTABLE_PATH "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome"

    {{ if .mac -}}
    source "$HOME/.settings.fish"
    {{ end -}}

    ##############################################################
    # SOURCING OTHER PROGRAM'S FISH SCRIPTS
    ##############################################################

    if command -v mise >/dev/null 2>&1
      mise activate fish | source
    end

    if command -v atuin >/dev/null >&1
      atuin init fish --disable-up-arrow --disable-ctrl-r | source
    end

    if test -f "$HOME/.config/lean-ctx/shell-hook.fish"
      source "$HOME/.config/lean-ctx/shell-hook.fish"
    end

    ##############################################################
    # ABBREVIATIONS
    ##############################################################

    {{ if .mac -}}
    abbr --add mm "sudo darwin-rebuild switch --flake $HOME/code/nixos-dotfiles#(hostname -s)"
    {{ else if .linux -}}
    if command -v nh >/dev/null 2>&1
        abbr --add mm "nh os switch $HOME/code/nixos-dotfiles --hostname (hostname -s)"
    else
        abbr --add mm "sudo nixos-rebuild switch --flake $HOME/code/nixos-dotfiles#(hostname -s)"
    end
    {{ end -}}

    abbr --add c clear
    abbr --add q exit

    abbr --add l 'eza --classify=auto --color=always --icons=always --almost-all --group-directories-first --long --binary --smart-group --header --mounts --octal-permissions --no-permissions --sort time'

    abbr --add hh _atuin_search

    abbr --add man 'batman'

    abbr --add d dirh
    abbr --add nd nextd
    abbr --add pd prevd

    abbr --add utc 'date -u'

    abbr --add ag 'rg'
    abbr --add rgd --position command --set-cursor=% 'rg % --json | delta'
    abbr --add rglit 'rg -F'

    abbr --add g git
    abbr --add qg git
    abbr --add gl 'git l'
    abbr --add gs 'git s'

    abbr --add n "nvim"
    abbr --add v "nvim"

    abbr --add pimin 'cd (mktemp -d); and pi'
    abbr --add piall "cd (mktemp -d); and touch foo; and pi --skill $HOME/.pi/agent/skills/curated-ai-skills"
    abbr --add pilean "pi -e $HOME/.pi/agent/extensions/pi-lean-ctx/"
    abbr --add piorchestrator "pi 'read $HOME/.pi/agent/skills/curated-ai-skills/orchestrator/SKILL.md and $HOME/.pi/agent/skills/curated-ai-skills/writing-multiagent-workflows/SKILL.md and the workflow agents in $HOME/.pi/agents'"

    abbr --add sss 'git show HEAD'

    abbr --add em "nvim $HOME/code/nixos-dotfiles/mac/cyan/configuration.nix"

    abbr --add et "nvim $HOME/code/nixos-dotfiles/chezmoi/dot_config/ghostty/config"
    abbr --add ek "nvim $HOME/code/nixos-dotfiles/chezmoi/dot_config/kitty/kitty.conf"
    abbr --add ew "nvim $HOME/code/nixos-dotfiles/chezmoi/dot_config/wezterm/wezterm.lua.tmpl"

    abbr --add ef "nvim $HOME/code/nixos-dotfiles/chezmoi/dot_config/fish/config.fish.tmpl"
    abbr --add eg "nvim $HOME/code/nixos-dotfiles/chezmoi/dot_gitconfig.tmpl"
    abbr --add eu "nvim $HOME/code/nixos-dotfiles/chezmoi/dot_config/tmux/tmux.conf.tmpl"
    abbr --add eh "nvim $HOME/code/nixos-dotfiles/chezmoi/dot_config/herdr/config.toml"

    abbr --add episet "nvim $HOME/code/nixos-dotfiles/chezmoi/dot_pi/agent/settings.json"
    abbr --add episys "nvim $HOME/code/nixos-dotfiles/chezmoi/dot_pi/agent/SYSTEM.md"
    abbr --add epim   "nvim $HOME/code/nixos-dotfiles/chezmoi/dot_pi/agent/models.json"
    abbr --add epims  "nvim $HOME/code/nixos-dotfiles/chezmoi/dot_pi/agent/models-store.json"

    abbr --add cm 'chezmoi'
    abbr --add cma "cd $HOME/code/nixos-dotfiles; chezmoi add $HOME/.pi/agent/settings.json; chezmoi add $HOME/.config/lean-ctx/config.toml; git add chezmoi/dot_pi/agent/settings.json; git add chezmoi/dot_config/private_lean-ctx/private_config.toml; git commit -m 'chore: autocommit config changes'; chezmoi apply"
    abbr --add cmt 'chezmoi chattr +template'

    abbr --add catjis 'iconv -f shift-jis -t utf-8'
    abbr --add mdcat 'mdcat --columns 180 --paginate'
    abbr --add glow "glow -s $HOME/Library/Preferences/glow/night-owl.json"
    abbr --add hsr 'herdr server reload-config'

    if command -v zk >/dev/null 2>&1
        abbr --add zn  "zk new --working-dir=$HOME/code/alcove --notebook-dir=$HOME/code/alcove --title"
        abbr --add zkn "zk new --working-dir=$HOME/code/alcove --notebook-dir=$HOME/code/alcove --title"
        abbr --add znt "zk new --working-dir=$HOME/code/alcove --notebook-dir=$HOME/code/alcove --title"

        abbr --add zj 'today'
    end

    if command -v commandcode >/dev/null >&1
        abbr --add cmd 'cmd --yolo --no-auto-update'
    end

    if command -v cargo >/dev/null 2>&1
        abbr --add cf 'cargo fmt'
        abbr --add cl 'cargo clippy'
        abbr --add ck 'cargo check'

        abbr --add cb 'cargo build'
        abbr --add cbr 'cargo build --release'

        abbr --add cr 'cargo run'
        abbr --add crr 'cargo run --release'

        abbr --add ct 'cargo test'
        abbr --add ctn 'cargo test -- --nocapture'

        abbr --add cdo 'cargo doc --open'
    end

    {{ if .mac -}}
    abbr --add mus "musikcube"
    abbr --add dua 'dua interactive'
    abbr --add epush "nvim $HOME/code/dotfiles/bin/_push_and_pull_android.sh"
    abbr --add epull "nvim $HOME/code/dotfiles/bin/_push_and_pull_android.sh"
    abbr --add pandoc "pandoc --pdf-engine=xelatex"
    {{ end -}}

    ##############################################################
    # PATH
    ##############################################################

    {{ if .mac -}}
    fish_add_path --global --prepend "/usr/local/share/dotnet"
    fish_add_path --global --prepend "/Applications/WezTerm.app/Contents/MacOS"
    fish_add_path --global --prepend "/Applications/LibreOffice.app/Contents/MacOS"
    fish_add_path --global --prepend "$HOME/.config/composer/vendor/bin"
    fish_add_path --global --prepend "$HOME/.cargo/bin"
    fish_add_path --global --prepend "$HOME/.bun/bin"
    fish_add_path --global --prepend "$HOME/.local/bin"
    fish_add_path --global --prepend "$HOME/code/dotfiles/bin"
    {{ end -}}
end

