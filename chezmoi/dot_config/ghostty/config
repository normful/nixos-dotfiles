# --------------------------------------
# Appearance: Font
# --------------------------------------

font-size = 18
window-inherit-font-size = true
font-thicken = false

# Despite this being WezTerm config, kitty's visual font previewer is very nice:
# Open kitty and run /Applications/kitty.app/Contents/MacOS/kitty list-fonts

font-family = Moralerspace Neon HWJPDOC
# font-feature = calt=1,clig=0,liga=0,zero,ss01

adjust-underline-position = 20%
adjust-underline-thickness = 5%

# Visual test text for fonts
# oO08 iIlL1 g9qCGQ ~-+=>;_
# â é ù ï ø ç Ã Ē Æ œ
# {a} (a) [a]
# [[ ]]
# (( ))
# -----------
# ___________
# ===========

# --------------------------------------
# Appearance: Colour Themes
# --------------------------------------

# Launch visual theme picker with
# /Applications/Ghostty.app/Contents/MacOS/ghostty +list-themes
# Many themes are built-in, so you most likely won't need to install any custom themes.
# theme = TokyoNight Storm
theme = Rapture
# theme = Snazzy

window-theme = dark

# --------------------------------------
# Appearance: Tab bar
# --------------------------------------

window-show-tab-bar = always
window-new-tab-position = current

# 1 row
macos-titlebar-style = tabs

# 2 rows: current tab's title and tab row
# macos-titlebar-style = transparent

# seems ugly to me because of mismatching colors
# macos-titlebar-style = native

# breaks tabbing feature altogether; new windows are launched
# macos-titlebar-style = hidden

macos-titlebar-proxy-icon = hidden

# --------------------------------------
# Appearance: Window
# --------------------------------------

window-width = 100
window-height = 44
window-padding-x = 0
window-padding-y = 0

macos-non-native-fullscreen = false
macos-window-buttons = hidden

window-decoration = client
fullscreen = false
maximize = true

# --------------------------------------
# Other
# --------------------------------------

auto-update-channel = tip

copy-on-select = clipboard
clipboard-read = ask
clipboard-write = allow
clipboard-trim-trailing-spaces = true
clipboard-paste-protection = true
app-notifications = no-clipboard-copy

link-previews = true

scrollback-limit = 3000

notify-on-command-finish = unfocused
notify-on-command-finish-after = 10m
notify-on-command-finish-action = bell,no-notify
bell-features = no-system,no-audio,no-attention,no-title,border

macos-shortcuts = deny

window-inherit-working-directory = false
tab-inherit-working-directory = true
split-inherit-working-directory = true

shell-integration = fish

# Explanation of what this does: https://ghostty.org/docs/help/terminfo#ssh
shell-integration-features = ssh-terminfo,ssh-env

initial-window = true

confirm-close-surface = false
quit-after-last-window-closed = true

auto-update = off
