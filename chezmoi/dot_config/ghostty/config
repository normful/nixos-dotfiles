# ----------------------------
# Keyboard Mappings
# ----------------------------

# Make left Option key send Alt
macos-option-as-alt = left

# To see default keybinds: /Applications/Ghostty.app/Contents/MacOS/ghostty +list-keybinds

# Clear all default keybinds
keybind = clear

# Reload config
keybind = cmd+r=reload_config

# Tabs: open and navigate
keybind = ctrl+a>c=new_tab
keybind = ctrl+a>n=new_tab
keybind = cmd+[=previous_tab
keybind = cmd+]=next_tab

# Current Tab: retitle
keybind = ctrl+a>,=prompt_surface_title

# Splits: open
keybind = ctrl+a>v=new_split:right
keybind = ctrl+a>s=new_split:down

# Splits: goto
keybind = ctrl+a>ctrl+a=goto_split:next
keybind = ctrl+a>h=goto_split:left
keybind = ctrl+a>j=goto_split:bottom
keybind = ctrl+a>k=goto_split:top
keybind = ctrl+a>l=goto_split:right

# Splits: resize
keybind = ctrl+a>equal=equalize_splits
keybind = ctrl+a>r>h=resize_split:left,80
keybind = ctrl+a>r>j=resize_split:down,80
keybind = ctrl+a>r>k=resize_split:up,80
keybind = ctrl+a>r>l=resize_split:right,80

# Splits: zoom/unzoom
keybind = ctrl+a>o=toggle_split_zoom

# Splits (and other surfaces): close
keybind = ctrl+a>x=close_surface

# Adjust font size
keybind = all:cmd+zero=reset_font_size
keybind = all:cmd+minus=decrease_font_size:0.5
keybind = all:cmd+equal=increase_font_size:0.5

# Scrolling
keybind = cmd+k=scroll_page_up
keybind = cmd+j=scroll_page_down

# Paste
keybind = cmd+v=paste_from_clipboard

# =============================================================================
# KEYBOARD PROTOCOL CHAIN
# =============================================================================
#
# Ghostty `text:` → tmux input parser → tmux CSI-u re-encoder → neovim
#
# TERMINFO MISMATCH PROBLEM:
# Xterm and tmux-256color terminfo define F13-F24 with DIFFERENT byte sequences.
# Sending xterm's encoding through tmux (extended-keys on + csi-u format) causes
# tmux to NOT recognize the key via terminfo lookup, resulting in mangled output.
#
#   F-key   | xterm terminfo    | tmux-256color terminfo
#   ---------|-------------------|-----------------------
#   F13     | \E[25~           | \E[1;2P              (Shift+F1)
#   F14     | \E[26~           | \E[1;2Q              (Shift+F2)
#   F15     | \E[28~           | \E[1;2R              (Shift+F3)
#   F16     | \E[29~           | \E[1;2S              (Shift+F4)
#   F17     | \E[31~           | \E[15;2~             (Shift+F5)
#   F18     | \E[32~           | \E[17;2~             (Shift+F6)
#   F19     | \E[33~           | \E[18;2~             (Shift+F7)
#   F20     | \E[34~           | \E[19;2~             (Shift+F8)
#
# All text: bindings below use tmux-256color encodings to ensure tmux correctly
# recognizes the key via terminfo lookup, then re-encodes it using the Kitty
# keyboard protocol's unambiguous PUA (Private Use Area) codes for neovim:
#
#   neovim receives   | Kitty PUA | Actual F-key
#   ------------------|-----------|---------------
#   CSI 57376;Nu     | 57376     | F13
#   CSI 57377;Nu     | 57377     | F14
#   CSI 57378;Nu     | 57378     | F15
#   CSI 57379;Nu     | 57379     | F16
#   CSI 57380;Nu     | 57380     | F17
#   CSI 57381;Nu     | 57381     | F18
#   CSI 57382;Nu     | 57382     | F19
#
# Source: https://sw.kovidgoyal.net/kitty/keyboard-protocol/#functional-key-definitions
#
# ======== IMPORTANT ========
# DO NOT PLACE ANY COMMENTS TO THE RIGHT OF THE KEYBINDS.
# Use `kitty +kitten show_key` to verify escape codes.
# ===========================

# Send CTRL+C (for quitting some programs)
keybind = cmd+c=text:\x03

# Send CTRL+O (for vim/nvim jump motions)
keybind = cmd+o=text:\x0f

# Send CTRL+N (for selecting next item in vim completion menu)
keybind = cmd+n=text:\x0e

# Send CTRL+P (for selecting previous item in vim completion menu)
keybind = cmd+p=text:\x10

# Send CTRL+S (for fish pager-toggle-search https://www.youtube.com/watch?v=dnj-Hpg7Qlo&t=20s)
keybind = cmd+`=text:\x13

# Send ALT+L
keybind = cmd+l=text:\x1bl

# ---------------------------------------------------------------------------
# F13-F18: each sends a tmux-256color terminfo encoding.
#
# When tmux recognizes the sequence via terminfo, it knows the exact F-key
# and re-encodes it using the Kitty protocol PUA code (unambiguous in all
# contexts). If we sent the xterm encoding instead, tmux would fail to match
# the key in its terminfo table and would mangle the output.
# ---------------------------------------------------------------------------

# F13 (Kitty PUA 57376)
keybind = cmd+d=text:\x1b[1;2P

# F14 (Kitty PUA 57377)
keybind = cmd+u=text:\x1b[1;2Q

# F15 (Kitty PUA 57378)
keybind = cmd+w=text:\x1b[1;2R

# F16 (Kitty PUA 57379)
keybind = cmd+b=text:\x1b[1;2S

# F17 (Kitty PUA 57380)
keybind = cmd+e=text:\x1b[15;2~

# F18 (Kitty PUA 57381)
keybind = cmd+x=text:\x1b[17;2~

# F19 (Kitty PUA 57382)
# NOTE: Don't bind CTRL+I because it's indistinguishable from Tab in terminals.
keybind = cmd+i=text:\x1b[18;2~

# F20 (Kitty PUA 57383)
keybind = cmd+t=text:\x1b[19;2~

# --------------------------------------
# Keyboard Mappings For
# https://github.com/badlogic/pi-mono/tree/main/packages/coding-agent
# --------------------------------------

keybind = alt+backspace=text:\x1b\x7f
keybind = shift+enter=text:\n

