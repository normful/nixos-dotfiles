[server]
wake_mode = "internal"

[keybindings]
scroll_up = ""
scroll_down = ""
scroll_page_up = "alt+k"
scroll_page_down = "alt+j"
model_switch_next = "alt+i"
model_switch_prev = "alt+u"
fallback_switch = ""
effort_increase = "alt+t"
effort_decrease = "alt+y"
centered_toggle = ""
scroll_prompt_up = ""
scroll_prompt_down = ""
scroll_bookmark = ""
auto_poke_toggle = "alt+p"
scroll_up_fallback = ""
scroll_down_fallback = ""
workspace_left = ""
workspace_down = ""
workspace_up = ""
workspace_right = ""
side_panel_toggle = "alt+1"
copy_selection_toggle = "alt+2"
diagram_pane_toggle = "alt+3"
typing_scroll_lock_toggle = "alt+4"
diff_mode_cycle = "alt+7"
info_widget_toggle = "alt+5"
todo_card_toggle = "alt+6"
swarm_panel_focus = "alt+shift+s"
new_terminal = "alt+shift+n"
open_resume = "alt+r"
session_picker_enter = "current-terminal"

[dictation]
command = ""
mode = "send"
key = "off"
timeout_secs = 90

[display]
diff_mode = "pinned"
queue_mode = false
auto_server_reload = true
mouse_capture = true
debug_socket = false
emoji = true
centered = false
show_thinking = true
reasoning_display = "current"
diagram_mode = "none"
markdown_spacing = "compact"
latex_rendering = "image"
pin_images = true
pin_todos = true
idle_animation = true
prompt_entry_animation = true
disabled_animations = []
diff_line_wrap = true
performance = "auto"
animation_fps = 30
redraw_fps = 30
prompt_preview = true
compact_notifications = false
copy_badge_alt_label = "Alt"
show_agentgrep_output = true
show_bash_output = true
tool_call_details = true
keybinding_hints = false
theme = "dark"
active_sessions_manager = true
external_sessions = true
usage_display = "used"
overscroll_status = "on"

[display.native_scrollbars]
chat = true
side_panel = true

[display.colors]

[features]
check_updates = false
memory = true
swarm = true
mermaid = true
auto_poke = true
message_timestamps = true
persist_memory_injections = true
kv_cache_miss_notices = true
update_channel = "stable"

[tools]
profile = ""
enabled = []
disabled = []
disable_base_tools = false
mcp_tools = "deferred"
mcp_tools_token_threshold = 1000

[acp]
profile = "standard"
tool_profile = "acp"

[auth]
trusted_external_sources = []
trusted_external_source_paths = []

[provider]
{{ if .mac -}}
default_provider = "opencode-go"
default_model = "omen-alpha"
{{ end -}}
{{ if .exeDevVm -}}
default_provider = "exedev-llm"
default_model = "fireworks/glm-5p3-flash"
{{ end -}}
openai_reasoning_effort = "low"
openai_service_tier = "priority"
openai_native_compaction_mode = "auto"
openai_native_compaction_threshold_tokens = 200000
preserve_reasoning_context = true
cross_provider_failover = "manual"
same_provider_account_failover = false
model_picker_providers = [
    "opencode-go",
{{ if .exeDevVm -}}
    "exedev-llm",
{{ end -}}
]
stream_idle_timeout_secs = 600
max_retries = 8
retry_backoff_cap_secs = 30

[providers]

[agents]
swarm_model = "inherit"
swarm_effort = "high"
swarm_spawn_mode = "inline"
swarm_strip_layout = "horizontal"
memory_model = "inherit"
memory_sidecar_enabled = true
memory_rerank_cadence = 3
memory_rerank_votes = 2
memory_rerank_min_agree = 2
memory_embedding_backend = "local"
swarm_max_concurrent_agents = 32

[terminal]
spawn_hook = "tmux new-window"

[hooks]
pre_tool_timeout_ms = 5000

[ambient]
enabled = true
{{ if .mac -}}
provider = "opencode-go"
model = "omen-alpha"
{{ end -}}
{{ if .exeDevVm -}}
provider = "exedev-llm"
model = "fireworks/glm-5p3-flash"
{{ end -}}
allow_api_keys = true
api_daily_budget = 100000
min_interval_minutes = 5
max_interval_minutes = 120
pause_on_active_session = true
proactive_work = true
work_branch_prefix = "ambient/"
visible = true

[safety]
ntfy_server = "https://ntfy.sh"
desktop_notifications = true
email_enabled = false
email_smtp_port = 587
email_imap_port = 993
email_reply_enabled = false
telegram_enabled = false
telegram_reply_enabled = false
discord_enabled = false
discord_reply_enabled = false
jade_relay_enabled = false
jade_relay_reply_enabled = false
jade_relay_launch_enabled = false

[notifications]
turn_complete = true
turn_complete_min_secs = 120
turn_complete_todo_min_secs = 30
turn_complete_only_when_unfocused = true
turn_complete_sound = ""

[gateway]
enabled = false

[compaction]
mode = "reactive"
lookahead_turns = 15
ewma_alpha = 0.30000001192092896
proactive_floor = 0.4000000059604645
min_samples = 3
stall_window = 5
min_turns_between_compactions = 10
topic_shift_threshold = 0.44999998807907104
relevance_keep_threshold = 0.6499999761581421
goal_window_turns = 5

[power]
prevent_sleep_while_streaming = true

[autoreview]
enabled = true

[autojudge]
enabled = true

[launch_hotkeys]
enabled = false
imported = true
entries = []

{{ if .exeDevVm -}}
[providers.exedev-llm]
type = "openai-compatible"
base_url = "https://llm.int.exe.xyz/v1"
auth = "none"
default_model = "fireworks/glm-5p3-flash"
requires_api_key = false

[[providers.exedev-llm.models]]
id = "fireworks/glm-5p3-flash"

[[providers.exedev-llm.models]]
id = "fireworks/deepseek-v4-flash-0731"

[[providers.exedev-llm.models]]
id = "fireworks/minimax-m3"
{{ end -}}
