  "packages": [
    "npm:pi-lean-ctx",
    "npm:@parallel-web/pi-extension",
    "npm:@normful/pi-statusline",
    "npm:@normful/pi-show-files-read",
    "npm:@normful/pi-show-theme-colors",
    "npm:@normful/pi-stop-secrets-leaks",
    "npm:@normful/pi-auto-name",
    "https://github.com/normful/pi-agent-browser-native",
    "https://github.com/normful/pi-mcp-adapter",
    {
      "source": "https://github.com/normful/picadillo",
      "extensions": [
        "-extensions/overstory.ts",
        "-extensions/mulch.ts",
        "-extensions/gastown.ts",
        "-extensions/respond.ts",
        "+extensions/parrot.ts"
      ],
      "skills": [
        "-skills/mulch/SKILL.md",
        "-skills/run-in-tmux/SKILL.md"
      ]
